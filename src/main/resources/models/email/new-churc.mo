<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Confirme sua conta no Church Lite</title>
</head>
<body style="margin:0;padding:0;background:#f5f3ff;color:#27272a;font-family:Arial,Helvetica,sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f3ff;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;background:#ffffff;border:1px solid #e4e4e7;border-radius:20px;overflow:hidden;">
          <tr>
            <td style="padding:32px;background:#18112b;text-align:center;">
              <div style="display:inline-block;padding:9px 13px;border-radius:12px;background:#7c3aed;color:#ffffff;font-size:20px;font-weight:700;letter-spacing:-0.5px;">CL</div>
              <div style="margin-top:14px;color:#ffffff;font-size:25px;font-weight:700;">Church Lite</div>
              <div style="margin-top:6px;color:#c4b5fd;font-size:13px;">Gestão simples para cuidar melhor da sua igreja</div>
            </td>
          </tr>
          <tr>
            <td style="padding:36px 38px 30px;">
              <h1 style="margin:0 0 18px;color:#27272a;font-size:25px;line-height:1.25;">Confirme seu endereço de e-mail</h1>
              <p style="margin:0 0 14px;color:#52525b;font-size:16px;line-height:1.65;">Olá, {{name}}!</p>
              <p style="margin:0 0 26px;color:#52525b;font-size:16px;line-height:1.65;">Sua conta foi criada. Confirme seu e-mail para ativar o acesso ao Church Lite e concluir a configuração da sua igreja.</p>
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto 28px;">
                <tr>
                  <td bgcolor="#7c3aed" style="border-radius:10px;">
                    <a href="{{url}}" style="display:inline-block;padding:15px 28px;color:#ffffff;text-decoration:none;font-size:16px;font-weight:700;">Confirmar minha conta</a>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 8px;color:#71717a;font-size:13px;line-height:1.55;">Se o botão não funcionar, copie e cole este endereço no navegador:</p>
              <p style="margin:0;padding:12px 14px;background:#f4f4f5;border-radius:8px;color:#6d28d9;font-size:12px;line-height:1.55;word-break:break-all;">{{url}}</p>
              <p style="margin:26px 0 0;color:#71717a;font-size:13px;line-height:1.55;">Se você não solicitou esta conta, ignore esta mensagem.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:22px 30px;background:#fafafa;border-top:1px solid #e4e4e7;text-align:center;color:#71717a;font-size:12px;line-height:1.6;">
              Church Lite · um produto SmartVerse<br>
              <a href="https://smartverse.com.br" style="color:#7c3aed;text-decoration:none;">smartverse.com.br</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
